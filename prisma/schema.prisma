generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Enquiries submitted through the contact form.
// The form also opens WhatsApp with the details pre-filled so nothing is lost.
model Enquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  business  String?
  service   String
  message   String
  createdAt DateTime @default(now())
}
